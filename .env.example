DASHBOARD_POLL_INTERVAL_MS=30000
PROVIDER_TIMEOUT_MS=8000
HOSTS_CONFIG_PATH=config/hosts.json
K3S_CONFIG_PATH=k3s.config

# Proxmox VE API
PROXMOX_API_URL=https://192.168.10.10:8006
PROXMOX_NODE=pve
PROXMOX_TOKEN_ID=homelab-index@pve!dashboard
PROXMOX_TOKEN_SECRET=replace-me
PROXMOX_VERIFY_TLS=false

# Unraid 7.2+ GraphQL API
UNRAID_GRAPHQL_URL=http://192.168.10.11/graphql
UNRAID_API_KEY=replace-me
UNRAID_NETWORK_INTERFACE=br0
UNRAID_VERIFY_TLS=true

# UniFi Network local integration API
UNIFI_API_URL=https://192.168.0.1/proxy/network/integration
UNIFI_API_KEY=replace-me
UNIFI_VERIFY_TLS=false

# Optional when more than one local site or gateway is present
# UNIFI_SITE_ID=replace-me
# UNIFI_GATEWAY_ID=replace-me

# UniFi Site Manager ISP metrics
UNIFI_SITE_MANAGER_API_URL=https://api.ui.com
UNIFI_SITE_MANAGER_API_KEY=replace-me

# Required only when the Site Manager key can access multiple sites
# UNIFI_SITE_MANAGER_SITE_ID=replace-me
